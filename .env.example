# Copy to .env.local and adjust for your machine.
# This is trusted shell configuration sourced by the Bash scripts.
IDF_PATH="$HOME/esp/v5.5.2/esp-idf"
IDF_TOOLS_PATH="$HOME/.espressif"
IDF_PYTHON_ENV_PATH="$HOME/.espressif/python_env/idf5.5_py3.12_env"
RLCD_EXAMPLE_DIR="$HOME/esp/rlcd-todo/validation/lvgl9"
# Optional for future manual serial operations; discover your current port first.
# ESPPORT=/dev/cu.usbmodemXXXX
